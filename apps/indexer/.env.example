# --- Memory tuning for full 29-chain local reindex ---
# Requires 16 GB+ system RAM. Without this the Node heap (default ~4 GB) OOMs
# after ~76 minutes when all chains are backfilling in parallel.
# NOTE: Node reads NODE_OPTIONS only at launch, before this .env is loaded, so
# this value is informational for `pnpm dev` — the effective heap size is set by
# the `dev` script in package.json. Keep the two in sync.
NODE_OPTIONS="--max-old-space-size=12288"
# Flush the in-memory entity/effect-cache store to Postgres sooner (default 100 000).
ENVIO_IN_MEMORY_OBJECTS_TARGET=40000

# HyperSync (every chain except hyperevm and metis syncs from HyperSync). Create or update a token at
# https://envio.dev/app/api-tokens
ENVIO_API_TOKEN="<YOUR-API-TOKEN>"
# Local infra: `pnpm infra:start` (docker-compose.yml at the repo root) runs Postgres and ClickHouse on these ports.
# With the hosts set, `envio dev` / `envio start` use them instead of starting containers of their own.
ENVIO_HASURA=false
ENVIO_PG_HOST=localhost
ENVIO_PG_PORT=55433
ENVIO_PG_USER=postgres
ENVIO_PG_PASSWORD=testing
ENVIO_PG_DATABASE=envio-dev
ENVIO_PG_PUBLIC_SCHEMA="beefy_balances"

# ClickHouse holds the event tables. Envio drops and recreates this database on a reindex: keep it dedicated.
ENVIO_CLICKHOUSE_HOST=http://localhost:18123
ENVIO_CLICKHOUSE_DATABASE=beefy_raw
ENVIO_CLICKHOUSE_USERNAME=default
ENVIO_CLICKHOUSE_PASSWORD=

# RPC-only mode (no HyperSync, no ENVIO_API_TOKEN): `pnpm start:rpc`, or set ENVIO_RPC_FOR=sync.

# RPC per chain: sync source for hyperevm (999) and metis (1088), HyperSync fallback elsewhere, and the one-time
# cached reads (token metadata, contract links, CLM pool state)
ENVIO_RPC_URL_42161=https://arb1.arbitrum.io/rpc # arbitrum
ENVIO_RPC_URL_43114=https://api.avax.network/ext/bc/C/rpc # avax
ENVIO_RPC_URL_8453=https://mainnet.base.org # base
ENVIO_RPC_URL_80094=https://rpc.berachain.com # berachain
ENVIO_RPC_URL_56=https://56.rpc.thirdweb.com # bsc
ENVIO_RPC_URL_1=https://eth.drpc.org # ethereum
ENVIO_RPC_URL_252=https://rpc.frax.com # fraxtal
ENVIO_RPC_URL_100=https://rpc.gnosischain.com # gnosis
ENVIO_RPC_URL_999=https://rpc.hyperliquid.xyz/evm # hyperevm
ENVIO_RPC_URL_59144=https://rpc.linea.build # linea
ENVIO_RPC_URL_1135=https://rpc.api.lisk.com # lisk
ENVIO_RPC_URL_5000=https://rpc.mantle.xyz # mantle
ENVIO_RPC_URL_1088=https://metis.rpc.hypersync.xyz # metis
ENVIO_RPC_URL_143=https://rpc.monad.xyz # monad
ENVIO_RPC_URL_4326=https://mainnet.megaeth.com/rpc # megaeth
ENVIO_RPC_URL_10=https://mainnet.optimism.io # optimism
ENVIO_RPC_URL_9745=https://rpc.plasma.to # plasma
ENVIO_RPC_URL_137=https://polygon-rpc.com # polygon
ENVIO_RPC_URL_4663=https://rpc.mainnet.chain.robinhood.com # robinhood
ENVIO_RPC_URL_1329=https://evm-rpc.sei-apis.com/ # sei
ENVIO_RPC_URL_146=https://rpc.soniclabs.com # sonic
ENVIO_RPC_URL_324=https://mainnet.era.zksync.io # zksync

