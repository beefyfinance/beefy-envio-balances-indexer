# Which jobs this process runs (comma separated). Default: all. Run one job per Heroku process type to scale them apart.
WORKER_JOBS=price-sync

# price-sync: connection URL of the TimescaleDB on Tiger Cloud (a postgresql:// URL with a read-only user and
# sslmode=require; set it in your own .env, never here) -> ClickHouse
TIMESCALE_DATABASE_URL=
PRICE_SYNC_INTERVAL_MINUTES=15

# ClickHouse we write to.
CLICKHOUSE_URL=http://localhost:18123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
# The indexer's database (Envio drops it on a reindex) and ours (prices, views): they must differ.
CLICKHOUSE_RAW_DATABASE=beefy_raw
CLICKHOUSE_ANALYTICS_DATABASE=beefy_analytics
