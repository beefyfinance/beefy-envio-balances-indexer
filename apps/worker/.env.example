# Which jobs this process runs (comma separated): advance, cleanup, version-status. Default: all. Run one job per Heroku
# process type to scale them apart.
WORKER_JOBS=

# advance: moves the price watermark of every version not dropped, storing the prices of the events it passes.
ADVANCE_INTERVAL_MINUTES=15
# Each reprice statement covers at most this many days of events and about REPRICE_MAX_EVENTS events (time ranges are
# split by event counts), and runs with these memory and time limits (within the pipeline user's profile). The
# watermark is written after each statement.
ADVANCE_STEP_DAYS=7
REPRICE_MAX_EVENTS=500000
REPRICE_MAX_MEMORY_MB=4096
REPRICE_MAX_EXECUTION_SECONDS=600
# Every advance retries the rows of this many days below the watermark that are not final (a late price or fact).
REPRICE_RETRY_DAYS=7
# The watermark stays at least this far behind now.
WATERMARK_MIN_AGE_HOURS=24
# ready and switch refuse a version with events older than this and no price at all.
PENDING_GRACE_MINUTES=15

# cleanup: drops versions retired for longer than the grace period (their tables, then their Envio database). Unknown
# databases and tables are only reported.
CLEANUP_INTERVAL_HOURS=24
CLEANUP_GRACE_HOURS=48

# version-status: logs every version and warns on a watermark older than WATERMARK_ALERT_SECONDS (default 2 days), a
# version building for longer than BUILDING_ALERT_HOURS, or no active version; for the active version, on more than
# UNPRICED_ALERT_PERCENT of the last hour's events without an indexer price (its price cache stopped), and on any PENDING
# event older than PENDING_ALERT_MINUTES (no provisional row written).
VERSION_STATUS_INTERVAL_MINUTES=5
WATERMARK_ALERT_SECONDS=172800
UNPRICED_ALERT_PERCENT=50
BUILDING_ALERT_HOURS=168
PENDING_ALERT_MINUTES=30

# On SIGTERM, how long a running job gets before the process exits anyway (Heroku allows 30 seconds).
SHUTDOWN_GRACE_SECONDS=10

# ClickHouse we write to.
CLICKHOUSE_URL=http://localhost:18123
# Required. An empty password is only accepted for a ClickHouse on localhost.
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
# Ours, never dropped: deployments, the API views and every version's tables (event_price_<N>, price_watermark_<N>).
# Each version's Envio database is recorded in deployments, not configured here.
CLICKHOUSE_ANALYTICS_DATABASE=beefy_analytics
# database.table of the databarn 5 minute prices (vault and CLM share prices included), read only. The hourly and daily
# tables are aggregates of it and are not read.
CLICKHOUSE_PRICE_5M_TABLE=analytics.asset_price_5m
# database.table mapping a token (chain, address) to its price asset, read only.
CLICKHOUSE_TOKEN_TABLE=analytics.token
# price_source values of the 5 minute table the watermark waits for (comma separated).
CLICKHOUSE_WATERMARK_PRICE_SOURCES=api,beefy_db
# The user the API views run as (SQL SECURITY DEFINER), so the API user needs no grant on what they read. Empty locally
# (the worker then warns at startup that the views run as the invoker).
CLICKHOUSE_DEFINER=
# Required. The common prefix of Envio's version databases: version N must be deployed on <prefix><N>, and cleanup never
# drops any other database.
CLICKHOUSE_ENVIO_DATABASE_PREFIX=envio_dev_mrt_
