{
  "name": "@beefy/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background jobs: price sync from the TimescaleDB on Tiger Cloud into ClickHouse, and any other scheduled work",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "start": "node src/main.ts",
    "test": "pnpm run test:ts && pnpm run test:unit && pnpm run test:lint",
    "test:ts": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:lint": "oxlint -c ../../.oxlintrc.json"
  },
  "dependencies": {
    "@beefy/config": "workspace:*",
    "@beefy/models": "workspace:*"
  },
  "devDependencies": {
    "@beefy/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^26.12.1"
  }
}
