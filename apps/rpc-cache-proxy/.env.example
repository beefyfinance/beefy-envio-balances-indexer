# One proxy per chain: `pnpm start` listens on 127.0.0.1:PORT and forwards to UPSTREAM_URL (a node or an rpc-pacer).
CHAIN_ID=10
UPSTREAM_URL=http://127.0.0.1:48562
PORT=48590
# Postgres holding sql/schema.sql (`pnpm schema` creates the tables)
DATABASE_URL=postgres://postgres:testing@127.0.0.1:55433/rpc_cache
# Which methods may be answered from the cache: logs,blocks,txs,calls. Everything is recorded whatever this says.
SERVE=logs,blocks,txs,calls
# `off` forwards everything and records nothing
CACHE=on
# Blocks this far below the head are final: only those are served
REORG_DEPTH=200
# A JSON file with the counters and timings, rewritten every REPORT_SECONDS (also served at GET /stats)
STATS_FILE=
# Postgres connections for lookups (writes use one more)
DB_MAX=8
