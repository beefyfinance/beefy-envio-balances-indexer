{
  "name": "@beefy/api",
  "version": "0.0.0",
  "private": true,
  "description": "Read API over the ClickHouse raw events and valued positions: Hono + OpenAPI, one deployable (Heroku)",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "start": "node src/main.ts",
    "test": "pnpm run test:ts && pnpm run test:unit && pnpm run test:lint",
    "test:ts": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:lint": "oxlint -c ../../.oxlintrc.json",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@beefy/clickhouse": "workspace:*",
    "@beefy/config": "workspace:*",
    "@beefy/models": "workspace:*",
    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "apache-arrow": "catalog:",
    "hono": "4.13.13",
    "remeda": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@beefy/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^26.13.0"
  }
}
