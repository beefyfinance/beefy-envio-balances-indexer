# Heroku sets PORT.
PORT=3000

# Use a read-only ClickHouse user: the API never writes.
CLICKHOUSE_URL=http://localhost:18123
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_RAW_DATABASE=beefy_raw
CLICKHOUSE_ANALYTICS_DATABASE=beefy_analytics
CLICKHOUSE_PRICE_DATABASE=dbt

# Where the client address for rate limiting comes from: the socket, or CF-Connecting-IP when the request comes from
# a Cloudflare address (set to cloudflare in production behind Cloudflare, never when the origin is reached directly).
CLIENT_IP=socket
CLIENT_RATE_PER_MINUTE=60
CLIENT_BURST=20
# Uncached requests (ClickHouse queries) per minute for everyone together, and the burst allowed.
MISSES_PER_MINUTE=1500
MISS_BURST=100
CACHE_MEGABYTES=128
MAX_IN_FLIGHT_QUERIES=8
MAX_QUEUED_QUERIES=64
QUERY_TIMEOUT_MS=3500
