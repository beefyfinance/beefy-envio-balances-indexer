# Heroku sets PORT.
PORT=3000

# Use a read-only ClickHouse user: the API never writes. It only reads the views user_timeline_api, product_contracts_api
# and api_status of our database, which point at the active version.
CLICKHOUSE_URL=http://localhost:18123
# Required. An empty password is only accepted for a ClickHouse on localhost.
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_ANALYTICS_DATABASE=beefy_analytics

# Where the client address for rate limiting comes from (IPv6 clients are limited per /64):
# - socket: the TCP peer (local development).
# - cloudflare: Cloudflare connects to this process; CF-Connecting-IP is believed when the peer is a Cloudflare address.
# - heroku-cloudflare: Cloudflare, then Heroku's router (production). The last X-Forwarded-For entry, appended by the
#   router, is the hop; CF-Connecting-IP is believed when that hop is a Cloudflare address.
CLIENT_IP=socket
CLIENT_RATE_PER_MINUTE=60
CLIENT_BURST=20
# Uncached requests (ClickHouse queries) per minute for everyone together, and the burst allowed.
MISSES_PER_MINUTE=1500
MISS_BURST=100
# The same per client, so one client cannot use up everyone's budget with addresses nobody else asks for.
CLIENT_MISSES_PER_MINUTE=20
CLIENT_MISS_BURST=10
CACHE_MEGABYTES=128
MAX_IN_FLIGHT_QUERIES=4
MAX_QUEUED_QUERIES=64
# How long a query may wait in the queue before the request is refused (503).
MAX_QUEUE_WAIT_MS=250
QUERY_TIMEOUT_MS=3500
# Every request is cut after this long.
REQUEST_TIMEOUT_MS=10000
# An account with more rows than this gets 413 instead of a response (the busiest real account has about 5 000).
MAX_TIMELINE_ROWS=10000

# The active version and its watermark (api_status) are read this often, in the background: a switch is picked up within
# this time. Keep it no longer than the origin's own freshness (10 to 45 seconds).
STATUS_REFRESH_SECONDS=10
STATUS_TIMEOUT_MS=3000
# The list of Beefy's own contracts (never served as users) is read again this often.
PRODUCT_CONTRACTS_REFRESH_MINUTES=60
# On SIGTERM, how long in-flight requests get before the process exits anyway (Heroku allows 30 seconds).
SHUTDOWN_GRACE_SECONDS=10

# /health (active version, price watermark age, cache) and /metrics (Prometheus), behind Authorization: Bearer <OPS_TOKEN>.
# Without a token they are not served at all. At least 32 characters: openssl rand -hex 32. /healthz is always open.
# /health says degraded when the active version's watermark is older than this many seconds (default 2 days).
WATERMARK_ALERT_SECONDS=172800
OPS_TOKEN=
