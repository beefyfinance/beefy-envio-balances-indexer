{
  "name": "beefy-balances",
  "version": "0.0.0",
  "private": true,
  "description": "Beefy balances monorepo: raw-events indexer, ClickHouse analytics schema and API",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "codegen": "turbo run codegen",
    "test": "turbo run test:ts test:unit test:lint //#test:secretlint",
    "test:ts": "turbo run test:ts",
    "test:unit": "turbo run test:unit",
    "test:lint": "turbo run test:lint",
    "test:secretlint": "git ls-files -z | xargs -0 secretlint --secretlintrc .secretlintrc.json --secretlintignore .secretlintignore --maskSecrets",
    "format": "oxfmt",
    "infra:start": "docker compose up --detach --wait",
    "infra:stop": "docker compose down",
    "infra:reset": "docker compose down --volumes",
    "clean": "turbo run clean && rm -rf .turbo",
    "deploy": "git checkout prod && git merge origin/main --ff-only && git push && git checkout -"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
    "lefthook": "2.2.1",
    "oxfmt": "0.74.0",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "7.0.2004",
    "secretlint": "13.0.7",
    "turbo": "2.11.10"
  },
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": "^26.13.0",
    "pnpm": "11.28.6"
  }
}
