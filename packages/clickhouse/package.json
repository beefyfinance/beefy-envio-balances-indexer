{
  "name": "@beefy/clickhouse",
  "version": "0.0.0",
  "private": true,
  "description": "ClickHouse side of the timeline: the API view over Envio's tables, stored prices below a watermark, versioned deployments, a thin layer over the official ClickHouse client, and the operations CLI",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate": "node --env-file-if-exists=.env src/cli.ts migrate",
    "test": "pnpm run test:ts && pnpm run test:unit && pnpm run test:lint",
    "test:ts": "tsc -p tsconfig.typecheck.json",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:lint": "oxlint -c ../../.oxlintrc.json",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@beefy/config": "workspace:*",
    "@clickhouse/client": "catalog:",
    "commander": "catalog:",
    "remeda": "catalog:"
  },
  "devDependencies": {
    "@beefy/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^26.13.0"
  }
}
