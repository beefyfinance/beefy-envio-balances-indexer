# The operations CLI (src/cli.ts): `node --env-file-if-exists=.env src/cli.ts --help`. Read and checked at startup by
# src/lib/config.ts; a missing or invalid value stops it before any command runs.

# ClickHouse, as the pipeline user (beefy_pipeline), or an administrator for `access`.
CLICKHOUSE_URL=http://localhost:18123
# Required. An empty password is only accepted for a ClickHouse on localhost.
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
# Ours, never dropped: deployments, the API views and every version's tables (event_price_<N>, price_watermark_<N>).
CLICKHOUSE_ANALYTICS_DATABASE=beefy_analytics
# database.table of the databarn 5 minute prices and of the token to price asset mapping, read only.
CLICKHOUSE_PRICE_5M_TABLE=analytics.asset_price_5m
CLICKHOUSE_TOKEN_TABLE=analytics.token
# price_source values of the 5 minute table the watermark waits for (comma separated).
CLICKHOUSE_WATERMARK_PRICE_SOURCES=api,beefy_db
# The user the API views run as (SQL SECURITY DEFINER). Empty locally.
CLICKHOUSE_DEFINER=
# Required. Version N must be deployed on <prefix><N>, and cleanup never drops any other database.
CLICKHOUSE_ENVIO_DATABASE_PREFIX=envio_dev_mrt_

# advance and reprice: each statement covers at most ADVANCE_STEP_DAYS days and about REPRICE_MAX_EVENTS events, with
# these memory and time limits (the same as the worker's; `access` gives the pipeline profile these as its caps).
ADVANCE_STEP_DAYS=7
REPRICE_MAX_EVENTS=500000
REPRICE_MAX_MEMORY_MB=4096
REPRICE_MAX_EXECUTION_SECONDS=600
REPRICE_RETRY_DAYS=7
WATERMARK_MIN_AGE_HOURS=24
# ready and switch refuse a version with events older than this and no price at all.
PENDING_GRACE_MINUTES=15
# cleanup's default grace period (--grace-hours overrides it).
CLEANUP_GRACE_HOURS=48

# access only: the users' passwords (at least 16 characters; sent as their SHA-256).
PIPELINE_PASSWORD=
API_PASSWORD=
# seed-synthetic writes fake data: yes on a scratch ClickHouse only.
ALLOW_SYNTHETIC=no
