{
  "name": "@beefy/config",
  "version": "0.0.0",
  "private": true,
  "description": "Typed, fail-fast environment parsing, the ClickHouse connection settings and the JSON line log shared by the apps",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run test:ts && pnpm run test:unit && pnpm run test:lint",
    "test:ts": "tsc -p tsconfig.typecheck.json",
    "test:unit": "vitest run",
    "test:lint": "oxlint -c ../../.oxlintrc.json",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@beefy/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^26.13.0"
  },
  "dependencies": {
    "pino": "catalog:",
    "remeda": "catalog:"
  }
}
