{
  "name": "@beefy/models",
  "version": "0.0.0",
  "private": true,
  "description": "Dependency-free domain models shared by the Beefy apps: chains, hex helpers",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run test:ts && pnpm run test:unit && pnpm run test:lint",
    "test:ts": "tsc -p tsconfig.typecheck.json",
    "test:unit": "vitest run",
    "test:lint": "oxlint -c ../../.oxlintrc.json",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@beefy/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^26.12.1"
  }
}
